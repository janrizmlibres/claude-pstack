{
  "description": "After a compaction in poteto-mode, lists the durable state the session should re-read before acting.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/poteto-mode-compaction.sh\""
          }
        ]
      }
    ]
  }
}
